{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pytest || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-test-edits.sh"
          }
        ]
      }
    ]
  }
}
